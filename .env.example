# Copy to .env and adjust. Defaults run everything against the local mocks.

# Ports on your machine, and the URL people use to reach n8n (review links use it).
N8N_HOST_PORT=5678
MOCK_HOST_PORT=8080
N8N_PUBLIC_URL=http://localhost:5678/
TIMEZONE=America/Toronto

# Owner account for the local n8n editor (created by scripts/setup.sh).
N8N_OWNER_EMAIL=demo@example.com
N8N_OWNER_PASSWORD=ChangeMe-123

# LLM: any OpenAI-compatible chat completions endpoint.
LLM_BASE_URL=http://mock:8080/llm/v1
LLM_MODEL=mock-model
LLM_API_KEY=mock-key

# Slack Web API (bot token needs chat:write; invite the bot to the three channels).
SLACK_API_BASE=http://mock:8080/slack/api
SLACK_BOT_TOKEN=xoxb-mock
SLACK_REVIEW_CHANNEL=content-review
SLACK_ALERT_CHANNEL=ops-alerts
SLACK_DIGEST_CHANNEL=content-team

# Notion: internal integration token, the content tracker and the client profiles (see docs/notion-database.md).
NOTION_API_BASE=http://mock:8080/notion/v1
NOTION_TOKEN=secret_mock
NOTION_DATABASE_ID=demo-content-tracker
NOTION_CLIENTS_DATABASE_ID=demo-clients

# Scheduling tool.
PUBLISHER_API_BASE=http://mock:8080/publisher/v1

# Review rules. A request is Urgent when it publishes within URGENT_WITHIN_DAYS days.
APPROVAL_TIMEOUT_MINUTES=2880
MAX_REVISIONS=2
URGENT_WITHIN_DAYS=2
